{
  "name": "@slkiser/opencode-quota",
  "version": "6.0.0",
  "packageManager": "pnpm@11.7.0",
  "description": "OpenCode quota & tokens usage with zero context window pollution. Supports GitHub Copilot, OpenAI (Plus/Pro), Google AGY, Z.ai coding plan and more.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "opencode-quota": "./dist/bin/opencode-quota.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    },
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node .github/scripts/clean-dist.mjs && tsc && tsc -p src/gui && node .github/scripts/copy-data.mjs && node .github/scripts/prepare-tui-dist.mjs && node .github/scripts/build-gui.mjs",
    "check": "vp check",
    "format": "vp fmt",
    "lint": "vp lint",
    "pack:release-package": "node .github/scripts/pack-release-package.mjs",
    "pricing:refresh": "node .github/scripts/refresh-modelsdev-pricing.mjs",
    "pricing:refresh:if-stale": "node .github/scripts/refresh-modelsdev-pricing-if-stale.mjs",
    "upstream:check": "node .github/scripts/check-upstream-plugin-updates.mjs",
    "upstream:prepare-review": "node .github/scripts/prepare-upstream-plugin-review.mjs",
    "upstream:sync": "node .github/scripts/sync-upstream-plugin-references.mjs",
    "release:check": "pnpm verify && pnpm run verify:release-version",
    "smoke:package": "node .github/scripts/smoke-packed-package.mjs",
    "verify:package-contents": "node .github/scripts/verify-package-contents.mjs",
    "verify:release-package": "node .github/scripts/verify-release-package.mjs",
    "verify:release-version": "node .github/scripts/verify-release-version.mjs",
    "verify:typescript-version": "node .github/scripts/verify-typescript-version.mjs",
    "verify:v4-history": "node .github/scripts/verify-v4-history.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "test:watch": "vp test watch",
    "verify": "pnpm run check && pnpm run verify:typescript-version && pnpm run verify:v4-history && pnpm run build && pnpm test && pnpm run verify:package-contents",
    "prepublishOnly": "pnpm run build",
    "prepare": "vp config --no-agent --hooks-dir .github/hooks"
  },
  "keywords": [
    "opencode",
    "plugin",
    "quota",
    "toast",
    "github",
    "copilot",
    "google",
    "gemini",
    "claude"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slkiser/opencode-quota.git"
  },
  "bugs": {
    "url": "https://github.com/slkiser/opencode-quota/issues"
  },
  "homepage": "https://github.com/slkiser/opencode-quota#readme",
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@opencode/plugin": "2.2.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentui/core": "^0.5.17",
    "@opentui/solid": "^0.5.17",
    "@types/node": "^22.0.0",
    "babel-preset-solid": "^1.9.12",
    "solid-js": "^1.9.12",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vite-plugin-solid": "2.11.14",
    "vite-plus": "1.2.0",
    "yaml": "^2.8.3"
  },
  "dependencies": {
    "@opentelemetry/api": "~1.9.1",
    "jsonc-parser": "^3.3.1"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.0.28",
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  }
}
