{
  "name": "@anthonyhaussman/opencode-agy-auth",
  "version": "1.4.7",
  "author": "antigravity",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anthonyhaussman/opencode-agy-auth.git"
  },
  "homepage": "https://github.com/anthonyhaussman/opencode-agy-auth#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "gemini",
    "antigravity",
    "agy",
    "google-gemini",
    "oauth",
    "ai-coding",
    "gemini-flash"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "models:refresh": "node scripts/fetch-models.mjs",
    "smoke:node-import": "node -e \"import('./dist/index.js').then(() => console.log('ok')).catch((error) => { console.error(error); process.exit(1); })\"",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@opencode-ai/sdk": "^1.19.4",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.105",
    "@openauthjs/openauth": "^0.4.3",
    "@opencode-ai/plugin": "^1.19.4"
  }
}
