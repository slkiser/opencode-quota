{
  "$schema": "https://biomejs.dev/schemas/2.3.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!pnpm-lock.yaml",
      "!!dist",
      "!!node_modules",
      "!!package-artifacts",
      "!!references/upstream-plugins",
      "!!src/data/modelsdev-pricing.min.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "domains": {
      "solid": "recommended"
    },
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "overrides": [
    {
      "includes": [
        "tests/**/*.test.ts",
        "tests/fixtures/**/*.ts",
        "contributing/provider-template/**/*.test.ts",
        "vitest.config.ts"
      ],
      "linter": {
        "domains": {
          "test": "recommended"
        }
      }
    },
    {
      "includes": ["src/lib/display-sanitize.ts", "src/lib/markdown-table.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noControlCharactersInRegex": "off"
          }
        }
      }
    },
    {
      "includes": ["src/plugin.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noMisleadingCharacterClass": "off"
          }
        }
      }
    },
    {
      "includes": ["src/providers/anthropic.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noImplicitAnyLet": "off"
          }
        }
      }
    },
    {
      "includes": ["src/tui.tsx", "src/tui-v2.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noStaticElementInteractions": "off"
          },
          "suspicious": {
            "noImplicitAnyLet": "off"
          }
        }
      }
    }
  ]
}
